# Local-only Phase 0 runtime. Do not reuse these values in production.
COMPOSE_PROJECT_NAME=mykb-phase0
WEKNORA_VERSION=v0.7.2
TZ=Asia/Shanghai
GIN_MODE=release
LOG_LEVEL=info
AUTO_MIGRATE=true

FRONTEND_PORT=18080
APP_PORT=18081

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=phase0
DB_PASSWORD=phase0_postgres_only
DB_NAME=mykb_phase0

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=phase0_redis_only
REDIS_DB=0
REDIS_PREFIX=mykb-phase0:

STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
RETRIEVE_DRIVER=postgres

JWT_SECRET=phase0-jwt-secret-not-for-production
SYSTEM_AES_KEY=phase0-system-aes-key-32-bytes!!
DISABLE_REGISTRATION=false
WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=true
WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
WEKNORA_TENANT_ENABLE_RBAC=true
WEKNORA_TENANT_AUTO_CREATE_API_KEY=false

OLLAMA_OPTIONAL=true
NEO4J_ENABLE=false
OIDC_AUTH_ENABLE=false
LLM_DEBUG_LOG=false

# Allows only the deterministic Phase 0 model sidecar in addition to upstream defaults.
SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,doris-be,mock-embedding
