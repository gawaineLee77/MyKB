# MindCreek managed defaults. This committed template contains no endpoint or
# credential value; WeKnora resolves the environment references at startup.
builtin_models:
  - id: builtin-mindcreek-chat
    name: ${MINDCREEK_MANAGED_LLM_NAME}
    type: KnowledgeQA
    source: remote
    description: MindCreek managed chat model
    is_default: true
    status: active
    parameters:
      base_url: ${MINDCREEK_MANAGED_LLM_BASE_URL}
      api_key: ${MINDCREEK_MANAGED_LLM_API_KEY}
      provider: ${MINDCREEK_MANAGED_LLM_PROVIDER}

  - id: builtin-mindcreek-embedding
    name: ${MINDCREEK_MANAGED_EMBEDDING_NAME}
    type: Embedding
    source: remote
    description: MindCreek managed embedding model
    is_default: true
    status: active
    parameters:
      base_url: ${MINDCREEK_MANAGED_EMBEDDING_BASE_URL}
      api_key: ${MINDCREEK_MANAGED_EMBEDDING_API_KEY}
      provider: ${MINDCREEK_MANAGED_EMBEDDING_PROVIDER}
      embedding_parameters:
        dimension: __MINDCREEK_EMBEDDING_DIMENSION__
        truncate_prompt_tokens: 0

  - id: builtin-mindcreek-rerank
    name: ${MINDCREEK_MANAGED_RERANK_NAME}
    type: Rerank
    source: remote
    description: MindCreek managed rerank model
    is_default: true
    status: active
    parameters:
      base_url: ${MINDCREEK_MANAGED_RERANK_BASE_URL}
      api_key: ${MINDCREEK_MANAGED_RERANK_API_KEY}
      provider: ${MINDCREEK_MANAGED_RERANK_PROVIDER}
