# Local Phase 4 runtime. Replace all sample secrets before a shared deployment.
COMPOSE_PROJECT_NAME=mindcreek-stage1
WEKNORA_VERSION=v0.7.2
MINDCREEK_UI_IMAGE=mindcreek-ui:phase4
MINDCREEK_UI_VERSION=0.5.0
MINDCREEK_GATEWAY_IMAGE=mindcreek-gateway:phase4
MINDCREEK_VERSION=0.5.0-phase4
MINDCREEK_UPSTREAM_TIMEOUT=5s
# Upgrade-only external volume overrides. Leave unset for a fresh deployment.
# MINDCREEK_PHASE0_POSTGRES_VOLUME=mykb-phase0_postgres-data
# MINDCREEK_PHASE0_FILES_VOLUME=mykb-phase0_data-files
# MINDCREEK_PHASE0_DOCREADER_VOLUME=mykb-phase0_docreader-tmp
TZ=Asia/Shanghai
GIN_MODE=release
LOG_LEVEL=info
AUTO_MIGRATE=true
MINDCREEK_DEPLOYMENT_ENV=development

FRONTEND_PORT=18080
APP_PORT=18081

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=mindcreek_stage1
DB_PASSWORD=replace-before-shared-deployment
DB_NAME=mindcreek_stage1

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-before-shared-deployment
REDIS_DB=0
REDIS_PREFIX=mindcreek-stage1:

STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
RETRIEVE_DRIVER=postgres

JWT_SECRET=replace-with-a-long-random-jwt-secret
# Development placeholder only. Production managed models require a new,
# exactly 32-byte value; changing it later requires credential re-encryption.
SYSTEM_AES_KEY=0123456789abcdef0123456789abcdef
DISABLE_REGISTRATION=false
WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=true
WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
WEKNORA_TENANT_ENABLE_RBAC=true
WEKNORA_TENANT_AUTO_CREATE_API_KEY=false

OLLAMA_OPTIONAL=true
NEO4J_ENABLE=false
OIDC_AUTH_ENABLE=false
LLM_DEBUG_LOG=false

# Phase 5 managed model defaults. Development uses the deterministic local
# sidecar when these values are blank. Staging/production must provide every
# value through this protected local file or an approved secret injector.
MINDCREEK_MANAGED_LLM_NAME=
MINDCREEK_MANAGED_LLM_BASE_URL=
MINDCREEK_MANAGED_LLM_API_KEY=
MINDCREEK_MANAGED_LLM_PROVIDER=
MINDCREEK_MANAGED_EMBEDDING_NAME=
MINDCREEK_MANAGED_EMBEDDING_BASE_URL=
MINDCREEK_MANAGED_EMBEDDING_API_KEY=
MINDCREEK_MANAGED_EMBEDDING_PROVIDER=
MINDCREEK_MANAGED_EMBEDDING_DIMENSION=64
MINDCREEK_MANAGED_RERANK_NAME=
MINDCREEK_MANAGED_RERANK_BASE_URL=
MINDCREEK_MANAGED_RERANK_API_KEY=
MINDCREEK_MANAGED_RERANK_PROVIDER=
MINDCREEK_MANAGED_ALLOW_HTTP=false

# Optional workspace-owned provider overrides. Enabling requires selecting the
# Phase 5 opt-in capability registry, a 32-byte SYSTEM_AES_KEY, and exact host
# allow-lists. Keep disabled for the default internal pilot.
MINDCREEK_USER_MODEL_OVERRIDES=false
# When enabling overrides, also set this to the opt-in registry below.
MINDCREEK_PHASE5_CAPABILITIES_FILE=../../config/phase5-capabilities.json
MINDCREEK_PHASE5_UI_IMAGE=mindcreek-ui:phase5
MINDCREEK_PHASE5_GATEWAY_IMAGE=mindcreek-gateway:phase5
MINDCREEK_MODEL_OVERRIDE_PROVIDERS=generic,openai
MINDCREEK_MODEL_OVERRIDE_HOSTS=
MINDCREEK_MODEL_OVERRIDE_ALLOW_HTTP=false

# Phase 5 Gate B corporate SSO. Keep disabled until the exact provider
# contract and externally reachable MindCreek origin are configured. The
# corporate client secret and broker client secret must be supplied only in
# this protected local file or by an approved secret injector.
MINDCREEK_IDENTITY_ENABLED=false
MINDCREEK_IDENTITY_PROTOCOL=oauth2
MINDCREEK_IDENTITY_ALLOW_INSECURE_HTTP=false
MINDCREEK_EXTERNAL_ORIGIN=
MINDCREEK_IDENTITY_PROVIDER_NAME=Corporate account
# Stable HTTPS namespace for this provider. It need not expose OIDC discovery
# when protocol=oauth2, but changing it creates distinct MindCreek identities.
MINDCREEK_IDENTITY_ISSUER=
# Plain OAuth 2.0 endpoints. Refresh is recorded for provider compatibility but
# is not used by the initial MindCreek login flow.
MINDCREEK_IDENTITY_AUTHORIZATION_URL=
MINDCREEK_IDENTITY_TOKEN_URL=
MINDCREEK_IDENTITY_USERINFO_URL=
MINDCREEK_IDENTITY_REFRESH_URL=
# OIDC-only alternative. Set protocol=oidc and leave this blank for the
# conventional <issuer>/.well-known/openid-configuration endpoint.
MINDCREEK_IDENTITY_DISCOVERY_URL=
MINDCREEK_IDENTITY_CLIENT_ID=
MINDCREEK_IDENTITY_CLIENT_SECRET=
MINDCREEK_IDENTITY_CLIENT_AUTH_METHOD=client_secret_post
# Corporate profile: browser form POST, form token exchange, and query-based
# UserInfo. Confirm whether the provider really spells the grant value
# "autorization_code"; keep the standard spelling below unless it does.
MINDCREEK_IDENTITY_AUTHORIZATION_METHOD=POST
MINDCREEK_IDENTITY_AUTHORIZATION_GRANT_TYPE=authorization_code
MINDCREEK_IDENTITY_PKCE_ENABLED=false
MINDCREEK_IDENTITY_STATE_REQUIRED=false
MINDCREEK_IDENTITY_USERINFO_TOKEN_TRANSPORT=query
MINDCREEK_IDENTITY_SCOPES=base.profile
# Plain OAuth 2.0 UserInfo mappings for the corporate five-field response.
# Set DATA_PATH (for example, data) only when these fields are nested.
MINDCREEK_IDENTITY_USERINFO_DATA_PATH=
MINDCREEK_IDENTITY_SUBJECT_CLAIM=globalUserID
MINDCREEK_IDENTITY_TENANT_CLAIM=tenantId
MINDCREEK_IDENTITY_SUBJECT_TENANT_SCOPED=true
MINDCREEK_IDENTITY_USERNAME_CLAIM=uid
MINDCREEK_IDENTITY_DISPLAY_NAME_CLAIM=uid
MINDCREEK_IDENTITY_UUID_CLAIM=uuid
MINDCREEK_IDENTITY_EMPLOYEE_TYPE_CLAIM=employeeType
MINDCREEK_IDENTITY_EMAIL_CLAIM=
MINDCREEK_IDENTITY_GROUP_CLAIM=
# Optional comma-separated allow-lists. Blank admits every successfully
# authenticated employee type/group from the configured provider.
MINDCREEK_IDENTITY_ALLOWED_EMPLOYEE_TYPES=
MINDCREEK_IDENTITY_REQUIRED_GROUPS=
MINDCREEK_BROKER_CLIENT_ID=mindcreek-weknora
MINDCREEK_BROKER_CLIENT_SECRET=
# Local WeKnora user IDs permitted only through the server-local emergency
# procedure. Leave blank until the break-glass account has been established.
MINDCREEK_BREAK_GLASS_USER_IDS=
# JIT login still creates the user's first personal workspace. This setting
# prevents subsequent self-service workspace creation through the normal API.
MINDCREEK_IDENTITY_TENANT_CREATION_ENABLED=false

# Phase 5 production edge. The production Compose profile publishes only this
# TLS reverse proxy. Paths are host paths and private keys must be mode 0600.
MINDCREEK_HTTP_BIND=0.0.0.0
MINDCREEK_HTTP_PORT=80
MINDCREEK_HTTPS_BIND=0.0.0.0
MINDCREEK_HTTPS_PORT=443
MINDCREEK_TLS_CERT_FILE=
MINDCREEK_TLS_KEY_FILE=

# Gate C recovery objectives and local protected backup destination.
MINDCREEK_BACKUP_ROOT=.local/backups
MINDCREEK_BACKUP_RPO_HOURS=24
MINDCREEK_BACKUP_RTO_MINUTES=30

# Test-only embedding sidecar. Configure approved models before real use.
SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,doris-be,mock-embedding,gateway
