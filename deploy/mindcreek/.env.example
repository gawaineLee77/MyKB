# Local Phase 4 runtime. Replace all sample secrets before a shared deployment.
COMPOSE_PROJECT_NAME=mindcreek-stage1
WEKNORA_VERSION=v0.7.2
MINDCREEK_UI_IMAGE=mindcreek-ui:phase4
MINDCREEK_UI_VERSION=0.5.0
MINDCREEK_GATEWAY_IMAGE=mindcreek-gateway:phase4
MINDCREEK_VERSION=0.5.0-phase4
MINDCREEK_UPSTREAM_TIMEOUT=5s
# Upgrade-only external volume overrides. Leave unset for a fresh deployment.
# MINDCREEK_PHASE0_POSTGRES_VOLUME=mykb-phase0_postgres-data
# MINDCREEK_PHASE0_FILES_VOLUME=mykb-phase0_data-files
# MINDCREEK_PHASE0_DOCREADER_VOLUME=mykb-phase0_docreader-tmp
TZ=Asia/Shanghai
GIN_MODE=release
LOG_LEVEL=info
AUTO_MIGRATE=true
MINDCREEK_DEPLOYMENT_ENV=development

FRONTEND_PORT=18080
APP_PORT=18081

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=mindcreek_stage1
DB_PASSWORD=replace-before-shared-deployment
DB_NAME=mindcreek_stage1

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-before-shared-deployment
REDIS_DB=0
REDIS_PREFIX=mindcreek-stage1:

STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
RETRIEVE_DRIVER=postgres

JWT_SECRET=replace-with-a-long-random-jwt-secret
# Development placeholder only. Production managed models require a new,
# exactly 32-byte value; changing it later requires credential re-encryption.
SYSTEM_AES_KEY=0123456789abcdef0123456789abcdef
DISABLE_REGISTRATION=false
WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=true
WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
WEKNORA_TENANT_ENABLE_RBAC=true
WEKNORA_TENANT_AUTO_CREATE_API_KEY=false

OLLAMA_OPTIONAL=true
NEO4J_ENABLE=false
OIDC_AUTH_ENABLE=false
LLM_DEBUG_LOG=false

# Phase 5 managed model defaults. Development uses the deterministic local
# sidecar when these values are blank. Staging/production must provide every
# value through this protected local file or an approved secret injector.
MINDCREEK_MANAGED_LLM_NAME=
MINDCREEK_MANAGED_LLM_BASE_URL=
MINDCREEK_MANAGED_LLM_API_KEY=
MINDCREEK_MANAGED_LLM_PROVIDER=
MINDCREEK_MANAGED_EMBEDDING_NAME=
MINDCREEK_MANAGED_EMBEDDING_BASE_URL=
MINDCREEK_MANAGED_EMBEDDING_API_KEY=
MINDCREEK_MANAGED_EMBEDDING_PROVIDER=
MINDCREEK_MANAGED_EMBEDDING_DIMENSION=64
MINDCREEK_MANAGED_RERANK_NAME=
MINDCREEK_MANAGED_RERANK_BASE_URL=
MINDCREEK_MANAGED_RERANK_API_KEY=
MINDCREEK_MANAGED_RERANK_PROVIDER=
MINDCREEK_MANAGED_ALLOW_HTTP=false

# Optional workspace-owned provider overrides. Enabling requires selecting the
# Phase 5 opt-in capability registry, a 32-byte SYSTEM_AES_KEY, and exact host
# allow-lists. Keep disabled for the default internal pilot.
MINDCREEK_USER_MODEL_OVERRIDES=false
# When enabling overrides, also set this to the opt-in registry below.
MINDCREEK_PHASE5_CAPABILITIES_FILE=../../config/phase5-capabilities.json
MINDCREEK_PHASE5_UI_IMAGE=mindcreek-ui:phase5
MINDCREEK_PHASE5_GATEWAY_IMAGE=mindcreek-gateway:phase5
MINDCREEK_MODEL_OVERRIDE_PROVIDERS=generic,openai
MINDCREEK_MODEL_OVERRIDE_HOSTS=
MINDCREEK_MODEL_OVERRIDE_ALLOW_HTTP=false

# Test-only embedding sidecar. Configure approved models before real use.
SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,doris-be,mock-embedding
