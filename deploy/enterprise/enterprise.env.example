# Generated secrets are filled by bin/mindcreek init. Never commit the instance file.
# Values are literal KEY=value or KEY='value'; no shell expansion or inline comments.
MINDCREEK_DEPLOYMENT_ENV=staging
MINDCREEK_EXTERNAL_ORIGIN=https://REPLACE_MINDCREEK_HOST
MINDCREEK_INSTALL_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
MINDCREEK_INSTALL_ADMIN_USERNAME=admin
MINDCREEK_DEFAULT_SPACE_NAME=默认空间
MINDCREEK_DEFAULT_SPACE_DESCRIPTION=企业默认知识空间
MINDCREEK_UID=__UID__
MINDCREEK_GID=__GID__
DB_USER=mindcreek
DB_NAME=mindcreek_r4
DB_PORT=5432
DB_PASSWORD=__DB_PASSWORD__
JWT_SECRET=__JWT_SECRET__
SYSTEM_AES_KEY=__SYSTEM_AES_KEY__
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_ADDR=redis:6379
REDIS_DB=0
MINDCREEK_BROKER_CLIENT_ID=mindcreek-weknora
MINDCREEK_BROKER_CLIENT_SECRET=__BROKER_SECRET__

# Provider values must match the company's approved OAuth application.
MINDCREEK_IDENTITY_PROTOCOL=oauth2
MINDCREEK_IDENTITY_PROVIDER_NAME=企业账号
MINDCREEK_IDENTITY_ISSUER=https://REPLACE_IDENTITY_HOST
MINDCREEK_IDENTITY_AUTHORIZATION_URL=https://REPLACE_IDENTITY_HOST/authorize
MINDCREEK_IDENTITY_TOKEN_URL=https://REPLACE_IDENTITY_HOST/token
MINDCREEK_IDENTITY_USERINFO_URL=https://REPLACE_IDENTITY_HOST/userinfo
MINDCREEK_IDENTITY_CLIENT_ID=REPLACE_CLIENT_ID
MINDCREEK_IDENTITY_CLIENT_SECRET=REPLACE_CLIENT_SECRET
MINDCREEK_IDENTITY_AUTHORIZATION_METHOD=GET
MINDCREEK_IDENTITY_TOKEN_REQUEST_FORMAT=form
MINDCREEK_IDENTITY_CLIENT_AUTH_METHOD=client_secret_post
MINDCREEK_IDENTITY_SCOPES=openid profile email
MINDCREEK_IDENTITY_SUBJECT_CLAIM=sub
MINDCREEK_IDENTITY_USERNAME_CLAIM=name
MINDCREEK_IDENTITY_DISPLAY_NAME_CLAIM=name
MINDCREEK_IDENTITY_EMAIL_CLAIM=email
MINDCREEK_IDENTITY_SUBJECT_TENANT_SCOPED=false
MINDCREEK_IDENTITY_PKCE_ENABLED=true
MINDCREEK_IDENTITY_STATE_REQUIRED=true
MINDCREEK_IDENTITY_ALLOW_INSECURE_HTTP=false

# Set model names, URLs, keys and the actual embedding output dimension.
MINDCREEK_MANAGED_LLM_NAME=REPLACE_CHAT_MODEL
MINDCREEK_MANAGED_LLM_BASE_URL=https://REPLACE_MODEL_HOST/v1
MINDCREEK_MANAGED_LLM_API_KEY=REPLACE_CHAT_KEY
MINDCREEK_MANAGED_LLM_PROVIDER=generic
MINDCREEK_MANAGED_EMBEDDING_NAME=REPLACE_EMBEDDING_MODEL
MINDCREEK_MANAGED_EMBEDDING_BASE_URL=https://REPLACE_MODEL_HOST/v1
MINDCREEK_MANAGED_EMBEDDING_API_KEY=REPLACE_EMBEDDING_KEY
MINDCREEK_MANAGED_EMBEDDING_PROVIDER=generic
MINDCREEK_MANAGED_EMBEDDING_DIMENSION=REPLACE_DIMENSION
MINDCREEK_MANAGED_RERANK_NAME=REPLACE_RERANK_MODEL
MINDCREEK_MANAGED_RERANK_BASE_URL=https://REPLACE_MODEL_HOST/v1
MINDCREEK_MANAGED_RERANK_API_KEY=REPLACE_RERANK_KEY
MINDCREEK_MANAGED_RERANK_PROVIDER=generic
MINDCREEK_MANAGED_VLM_ENABLED=false
MINDCREEK_MANAGED_ALLOW_HTTP=false
MINDCREEK_USER_MODEL_OVERRIDES=false
# Exact approved intranet model hosts, comma-separated; no '*' or private CIDR.
SSRF_WHITELIST_EXTRA=REPLACE_MODEL_HOST

FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=18080
TLS_BIND_IP=0.0.0.0
TLS_PORT=443
LOG_LEVEL=warn
GIN_MODE=release
LLM_DEBUG_LOG=false
AUTO_MIGRATE=true
MAX_FILE_SIZE_MB=500
DEFAULT_LOCALE=zh-CN
TZ=Asia/Shanghai
MINDCREEK_UPSTREAM_TIMEOUT=120s

# R5: enable only after updating both gateway and frontend to an R5 build.
MINDCREEK_EMPLOYEE_ASSISTANT_ENABLED=false
