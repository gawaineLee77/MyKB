# Dedicated fresh enterprise installation. Copy outside Git and replace secrets.
# Password is supplied only in SECRET_DIR/admin-password (0600), never here.
WEKNORA_VERSION=v0.8.0
FRONTEND_PORT=18080
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=mindcreek
DB_NAME=mindcreek_enterprise
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
SYSTEM_AES_KEY=REPLACE_WITH_32_BYTE_SECRET_VALUE
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_SECRET
REDIS_ADDR=redis:6379
REDIS_DB=0
REDIS_PREFIX=mindcreek-enterprise:
STREAM_MANAGER_TYPE=redis
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
RETRIEVE_DRIVER=postgres
AUTO_MIGRATE=true
GIN_MODE=release
LOG_LEVEL=info
LLM_DEBUG_LOG=false
OLLAMA_OPTIONAL=true
NEO4J_ENABLE=false

MINDCREEK_INSTALL_ADMIN_EMAIL=admin@example.invalid
MINDCREEK_INSTALL_ADMIN_USERNAME=admin
MINDCREEK_DEFAULT_SPACE_NAME=默认空间
# Set to the numeric owner of SECRET_DIR on the installation host.
MINDCREEK_R2_UID=1000
MINDCREEK_R2_GID=1000

# Fill from the approved corporate OAuth configuration; no company endpoints here.
MINDCREEK_IDENTITY_ENABLED=true
MINDCREEK_IDENTITY_PROTOCOL=oauth2
MINDCREEK_EXTERNAL_ORIGIN=https://mindcreek.example.invalid
MINDCREEK_IDENTITY_ISSUER=https://identity.example.invalid
MINDCREEK_IDENTITY_AUTHORIZATION_URL=https://identity.example.invalid/authorize
MINDCREEK_IDENTITY_TOKEN_URL=https://identity.example.invalid/token
MINDCREEK_IDENTITY_USERINFO_URL=https://identity.example.invalid/userinfo
MINDCREEK_IDENTITY_CLIENT_ID=REPLACE_WITH_CLIENT_ID
MINDCREEK_IDENTITY_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
MINDCREEK_BROKER_CLIENT_SECRET=REPLACE_WITH_RANDOM_BROKER_SECRET
MINDCREEK_IDENTITY_AUTHORIZATION_METHOD=GET
MINDCREEK_IDENTITY_TOKEN_REQUEST_FORMAT=form
MINDCREEK_IDENTITY_SUBJECT_CLAIM=sub
MINDCREEK_IDENTITY_USERNAME_CLAIM=name
MINDCREEK_IDENTITY_DISPLAY_NAME_CLAIM=name
MINDCREEK_IDENTITY_EMAIL_CLAIM=email
MINDCREEK_IDENTITY_SUBJECT_TENANT_SCOPED=false
MINDCREEK_IDENTITY_PKCE_ENABLED=true
MINDCREEK_IDENTITY_STATE_REQUIRED=true

# Synthetic model defaults for local acceptance only. Replace with approved models.
MINDCREEK_MANAGED_LLM_NAME=mindcreek-test-chat
MINDCREEK_MANAGED_LLM_BASE_URL=http://mock-embedding:19090/v1
MINDCREEK_MANAGED_LLM_API_KEY=synthetic-only
MINDCREEK_MANAGED_LLM_PROVIDER=generic
MINDCREEK_MANAGED_EMBEDDING_NAME=mindcreek-test-embedding
MINDCREEK_MANAGED_EMBEDDING_BASE_URL=http://mock-embedding:19090/v1
MINDCREEK_MANAGED_EMBEDDING_API_KEY=synthetic-only
MINDCREEK_MANAGED_EMBEDDING_PROVIDER=generic
MINDCREEK_MANAGED_EMBEDDING_DIMENSION=768
MINDCREEK_MANAGED_RERANK_NAME=mindcreek-test-rerank
MINDCREEK_MANAGED_RERANK_BASE_URL=http://mock-embedding:19090/v1
MINDCREEK_MANAGED_RERANK_API_KEY=synthetic-only
MINDCREEK_MANAGED_RERANK_PROVIDER=generic
MINDCREEK_USER_MODEL_OVERRIDES=false
