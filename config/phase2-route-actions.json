      "action": "manage_grants",
      "method_regex": "^(?:GET|POST|PUT|DELETE)$",
      "path_regex": "^/api/v1/(?:knowledge-bases|agents)/:id/shares(?:/|$)"
    },
    {
      "id": "manage-organization-sharing-control-plane",
