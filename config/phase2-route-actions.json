      "action": "edit_content",
      "method_regex": "^POST$",
      "path_regex": "^/api/v1/(?:knowledge-bases/:id/(?:faq/(?:entries|entry)$|knowledge(?:/|$)|tags$)|knowledge(?:/|$)|chunks(?:/|$)|knowledgebase/:kb_id/wiki(?:/|$))"
    },
    {
      "id": "edit-kb-content-puts",
      "action": "edit_content",
      "method_regex": "^PUT$",
      "path_regex": "^/api/v1/(?:knowledge-bases/:id/(?:faq(?:/|$)|knowledge(?:/|$)|tags(?:/|$))|knowledge(?:/|$)|chunks(?:/|$)|knowledgebase/:kb_id/wiki(?:/|$))"
    },
    {
      "id": "edit-kb-content-deletes",
      "action": "edit_content",
      "method_regex": "^DELETE$",
      "path_regex": "^/api/v1/(?:knowledge-bases/:id/(?:faq(?:/|$)|knowledge(?:/|$)|tags(?:/|$))|knowledge(?:/|$)|chunks(?:/|$)|knowledgebase/:kb_id/wiki(?:/|$))"
    },
    {
      "id": "read-kb-and-derived-content",
      "action": "read",
      "method_regex": "^GET$",
      "path_regex": "^/api/v1/(?:knowledge-bases/:id(?:$|/(?:activity|faq(?:/|$)|files$|hybrid-search$|knowledge(?:/|$)|move-targets$|tags$))|knowledge(?:/:id(?:/|$)|/batch$|/search$)|chunks(?:/|$)|knowledgebase/:kb_id/wiki(?:/|$)|initialization/config/:kbId$)"
